{
  "name": "aerolith-erp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @aerolith/kernel db:generate && pnpm --filter \"./packages/modules/*\" db:generate",
    "db:migrate": "pnpm --filter @aerolith/kernel db:migrate && pnpm --filter \"./packages/modules/*\" db:migrate",
    "db:seed": "pnpm --filter @aerolith/kernel db:seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test",
    "db:seed:demo": "pnpm --filter @aerolith/api db:seed:demo",
    "estate": "pnpm --filter @aerolith/kernel estate",
    "provision": "pnpm --filter @aerolith/api provision",
    "operator": "pnpm --filter @aerolith/kernel operator"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
