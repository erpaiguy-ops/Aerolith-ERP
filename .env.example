# Database
DATABASE_URL=postgres://aerolith:aerolith@localhost:5432/aerolith
# Connection used by migrations and seeds. Must be a role that owns the schemas.
# The application connects as a separate, non-superuser role so that Row Level
# Security is actually enforced (superusers and table owners bypass RLS).
DATABASE_APP_URL=postgres://aerolith_app:aerolith_app@localhost:5432/aerolith

# The vendor's own read-only role, for the estate report (`pnpm estate`).
# Both are OPTIONAL and belong only where an operator surface actually runs —
# leave them unset in the API's environment, and no bug in that codebase can
# read across tenants, because it holds nothing that could. Setting the
# password at migration time is what gives the role LOGIN; without it the role
# exists but cannot connect. See docs/07-platform-operations.md.
# PLATFORM_DB_PASSWORD=aerolith_platform
# DATABASE_PLATFORM_URL=postgres://aerolith_platform:aerolith_platform@localhost:5432/aerolith

# App
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000

# Auth
AUTH_SECRET=change-me-32-bytes-minimum-in-production

# Object storage (Cloudflare R2 — S3 compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=aerolith-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
SMTP_URL=
TELEGRAM_BOT_TOKEN=

# --- Production only (docker-compose.prod.yml) --------------------------
#
# Dev's docker-compose.yml hardcodes aerolith/aerolith — fine on a machine
# nobody else reaches. Production reads real secrets from here instead, per
# docs/04-infrastructure.md's security baseline: "Secrets in the deployment
# environment only. Never in the repo."

# Postgres superuser password. Only migrate/seed and the DB container itself
# see this — the api connects as aerolith_app (below), not as this role.
POSTGRES_PASSWORD=

# Password for the RLS-enforced `aerolith_app` role, created by `pnpm
# db:migrate` (packages/kernel/scripts/migrate.ts) if it does not already
# exist. Change this from its dev default before the first production migrate
# — the role is not recreated on later runs, so this only takes effect once.
APP_DB_PASSWORD=

# Cloudflare Tunnel token (dashboard → Zero Trust → Tunnels → your tunnel →
# "Install and run a connector"). Lets the box serve traffic with no inbound
# port open at all.
TUNNEL_TOKEN=
