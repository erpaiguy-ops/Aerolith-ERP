  "taxRegimes": [
    {
      "code": "SA_VAT",
      "name": "Saudi Value Added Tax",
      "type": "vat",
      "registrationLabel": "VAT Number",
      "registrationRegex": "^3\\d{14}$",
      "registrationHint": "15-digit VAT registration number",
      "filingFrequency": "monthly",
      "supportsReverseCharge": true,
      "supportsDesignatedZones": false,
      "registrationThreshold": 375000,
      "einvoicingScheme": "ZATCA_FATOORA",
      "einvoicingConfig": {
        "phase": 2,
        "note": "Phase 2 integration applies in waves by taxpayer revenue. Confirm the tenant's wave and onboarding deadline with ZATCA. Requires cryptographic stamping, UUID, hash chaining and a QR code."
      },
      "effectiveFrom": "2020-07-01",
      "taxCodes": [
        {
          "code": "SR",
          "name": "Standard Rated 15%",
          "rate": 15,
          "applicability": "both",
          "isDefault": true,
          "sortOrder": 1
        },
        { "code": "ZR", "name": "Zero Rated", "rate": 0, "applicability": "both", "sortOrder": 2 },
        {
          "code": "EX",
          "name": "Exempt",
          "rate": 0,
          "applicability": "both",
          "isRecoverable": false,
          "sortOrder": 3
        },
        {
          "code": "RC",
          "name": "Reverse Charge",
          "rate": 15,
          "applicability": "purchase",
          "isReverseCharge": true,
          "sortOrder": 4
        },
        {
          "code": "OS",
          "name": "Out of Scope",
          "rate": 0,
          "applicability": "both",
          "isRecoverable": false,
          "sortOrder": 5
        }
      ]
    }
  ],

  "holidays": [
    {
      "code": "EID_AL_FITR",
      "name": "Eid Al Fitr",
      "calculation": "hijri",
      "rule": { "hijriMonth": 10, "hijriDay": 1 },
      "defaultDurationDays": 4
    },
    {
      "code": "EID_AL_ADHA",
      "name": "Eid Al Adha",
      "calculation": "hijri",
      "rule": { "hijriMonth": 12, "hijriDay": 10 },
      "defaultDurationDays": 4
    },
    {
      "code": "FOUNDING_DAY",
      "name": "Founding Day",
      "calculation": "fixed_gregorian",
      "rule": { "month": 2, "day": 22 },
      "defaultDurationDays": 1
    },
    {
      "code": "NATIONAL_DAY",
      "name": "Saudi National Day",
      "calculation": "fixed_gregorian",
      "rule": { "month": 9, "day": 23 },
      "defaultDurationDays": 1
    }
  ],

  "rules": {
    "hr.working_time.standard_daily_hours": 8,
    "hr.working_time.standard_weekly_hours": 48,
    "hr.working_time.ramadan_daily_hours": 6,
    "hr.working_time.midday_break": {
      "startTime": "12:00",
      "endTime": "15:00",
      "fromMonthDay": "06-15",
      "toMonthDay": "09-15",
      "appliesTo": "outdoor_work"
    },

    "payroll.overtime.weekday_multiplier": 1.5,
    "payroll.overtime.night_multiplier": 1.5,
    "payroll.overtime.rest_day_multiplier": 1.5,
    "payroll.overtime.holiday_multiplier": 1.5,

    "hr.leave.annual_days": 21,
    "hr.leave.annual_accrual_basis": "calendar",
    "hr.leave.sick_leave_scale": [
      { "days": 30, "payPercent": 100 },
      { "days": 60, "payPercent": 75 },
      { "days": 30, "payPercent": 0 }
    ],
    "hr.leave.maternity_days": 70,
    "hr.probation.max_months": 6,
    "hr.notice.minimum_days": 60,

    "payroll.end_of_service.scheme": {
      "basis": "total_salary",
      "bands": [
        { "fromYears": 0, "toYears": 5, "daysPerYear": 15 },
        { "fromYears": 5, "toYears": null, "daysPerYear": 30 }
      ],
      "minimumServiceYears": 2
    },
    "payroll.end_of_service.cap_years": null,

    "payroll.wps.enabled": true,
    "payroll.wps.file_format": "SA_WPS",
    "payroll.wps.deadline_days": 10,
    "payroll.social_insurance": {
      "appliesTo": ["national", "gcc", "expatriate"],
      "note": "GOSI: nationals pay pension plus occupational hazard; expatriates occupational hazard only. Confirm current rates.",
      "nationalEmployerPercent": 11.75,
      "nationalEmployeePercent": 9.75,
      "expatriateEmployerPercent": 2,
      "expatriateEmployeePercent": 0,
      "basis": "contribution_salary"
    },

    "contract.retention.default_percent": 10,
    "contract.retention.release_schedule": { "practicalCompletion": 50, "endOfDlp": 50 },
    "contract.dlp.default_months": 12,
    "contract.payment_terms.default_days": 60,

    "document.retention.statutory_years": 10,
    "tax.invoice.required_fields": [
      "supplierName",
      "supplierAddress",
      "supplierVatNumber",
      "customerName",
      "customerVatNumber",
      "invoiceNumber",
      "invoiceUuid",
      "invoiceDate",
      "lineDescription",
      "lineQuantity",
      "lineUnitPrice",
      "lineTaxRate",
      "totalExcludingTax",
      "taxAmount",
      "totalIncludingTax",
      "qrCode",
      "previousInvoiceHash"
    ],
    "tax.invoice.language_requirement": ["ar"],

    "accommodation.max_occupants_per_room": 4,
    "accommodation.min_area_per_occupant_sqm": 4
  },

  "ruleSources": {
    "hr.leave.annual_days": "Saudi Labour Law",
    "payroll.end_of_service.scheme": "Saudi Labour Law, end-of-service award",
    "tax.invoice.required_fields": "ZATCA e-invoicing (Fatoora) Phase 2 requirements"
  },

  "notes": "Statutory values are seeded as a starting point and must be verified against current law before payroll or tax is run in production. ZATCA Phase 2 requires accredited integration; the invoice fields above are the data model requirement, not the full integration."
}
