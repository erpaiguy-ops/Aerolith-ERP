  "rules": {
    "hr.working_time.standard_daily_hours": 8,
    "hr.working_time.standard_weekly_hours": 48,
    "hr.working_time.ramadan_daily_hours": 6,
    "hr.working_time.midday_break": {
      "startTime": "12:30",
      "endTime": "15:00",
      "fromMonthDay": "06-15",
      "toMonthDay": "09-15",
      "appliesTo": "outdoor_work"
    },

    "payroll.overtime.weekday_multiplier": 1.25,
    "payroll.overtime.night_multiplier": 1.5,
    "payroll.overtime.rest_day_multiplier": 1.5,
    "payroll.overtime.holiday_multiplier": 1.5,

    "hr.leave.annual_days": 30,
    "hr.leave.annual_accrual_basis": "calendar",
    "hr.leave.sick_leave_scale": [
      { "days": 15, "payPercent": 100 },
      { "days": 30, "payPercent": 50 },
      { "days": 45, "payPercent": 0 }
    ],
    "hr.leave.maternity_days": 60,
    "hr.probation.max_months": 6,
    "hr.notice.minimum_days": 30,

    "payroll.end_of_service.scheme": {
      "basis": "basic_salary",
      "bands": [
        { "fromYears": 0, "toYears": 5, "daysPerYear": 21 },
        { "fromYears": 5, "toYears": null, "daysPerYear": 30 }
      ],
      "minimumServiceYears": 1
    },
    "payroll.end_of_service.cap_years": 2,

    "payroll.wps.enabled": true,
    "payroll.wps.file_format": "AE_SIF",
    "payroll.wps.deadline_days": 15,
    "payroll.social_insurance": {
      "appliesTo": ["national", "gcc"],
      "employerPercent": 12.5,
      "employeePercent": 5,
      "basis": "contribution_salary"
    },

    "contract.retention.default_percent": 10,
    "contract.retention.release_schedule": { "practicalCompletion": 50, "endOfDlp": 50 },
    "contract.dlp.default_months": 12,
    "contract.payment_terms.default_days": 60,

    "document.retention.statutory_years": 7,
    "tax.invoice.required_fields": [
      "supplierName",
      "supplierAddress",
      "supplierTrn",
      "customerName",
      "customerTrn",
      "invoiceNumber",
      "invoiceDate",
      "supplyDate",
      "lineDescription",
      "lineQuantity",
      "lineUnitPrice",
      "lineTaxRate",
      "taxAmountAed",
      "totalExcludingTax",
      "totalIncludingTax"
    ],
    "tax.invoice.language_requirement": ["en", "ar"],

    "accommodation.max_occupants_per_room": 8,
    "accommodation.min_area_per_occupant_sqm": 3
  },

  "ruleSources": {
    "hr.leave.annual_days": "Federal Decree-Law No. 33 of 2021 (UAE Labour Law)",
    "payroll.end_of_service.scheme": "Federal Decree-Law No. 33 of 2021, end-of-service gratuity",
    "hr.working_time.midday_break": "MOHRE annual midday break resolution",
    "payroll.wps.enabled": "MOHRE Wage Protection System"
  },

  "notes": "Statutory values are seeded as a starting point and must be verified against current law and the tenant's own contracts before payroll or tax is run in production. Ministerial resolutions change these numbers; the pack version is how corrections are shipped."
}
