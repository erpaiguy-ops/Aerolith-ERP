      { "days": 28, "payPercent": 50 },
      { "days": 42, "payPercent": 0 }
    ],
    "hr.leave.maternity_days": 50,
    "hr.probation.max_months": 6,
    "hr.notice.minimum_days": 30,

    "payroll.end_of_service.scheme": {
      "basis": "basic_salary",
      "bands": [{ "fromYears": 0, "toYears": null, "daysPerYear": 21 }],
      "minimumServiceYears": 1,
      "note": "Statutory minimum is three weeks' basic pay per year of service; many contracts improve on it."
    },
    "payroll.end_of_service.cap_years": null,

    "payroll.wps.enabled": true,
    "payroll.wps.file_format": "QA_WPS",
    "payroll.wps.deadline_days": 7,
    "payroll.social_insurance": {
      "appliesTo": ["national"],
      "employerPercent": 14,
      "employeePercent": 7,
      "basis": "contribution_salary"
    },

    "contract.retention.default_percent": 10,
    "contract.retention.release_schedule": { "practicalCompletion": 50, "endOfDlp": 50 },
    "contract.dlp.default_months": 12,
    "contract.payment_terms.default_days": 60,

    "document.retention.statutory_years": 10,
    "tax.invoice.required_fields": [
      "supplierName",
      "supplierAddress",
      "supplierTin",
      "customerName",
      "invoiceNumber",
      "invoiceDate",
      "lineDescription",
      "lineQuantity",
      "lineUnitPrice",
      "totalAmount"
    ],
    "tax.invoice.language_requirement": ["en", "ar"],

    "accommodation.max_occupants_per_room": 4,
    "accommodation.min_area_per_occupant_sqm": 4
  },

  "ruleSources": {
    "hr.leave.annual_days": "Law No. 14 of 2004 (Qatar Labour Law)",
    "payroll.end_of_service.scheme": "Law No. 14 of 2004, end-of-service gratuity",
