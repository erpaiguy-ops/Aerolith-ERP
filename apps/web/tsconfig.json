{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  // Deliberately NOT ".next/types/**/*.ts". Those are generated by `next build`,
  // so including them makes `typecheck` fail on a clean checkout — which is
  // exactly what CI is. `next build` type-checks the generated route types
  // itself, and that build now runs in CI, so nothing is lost.
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
